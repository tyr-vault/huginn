# Scrape concurrency (keep low by default)
HUGINN_CONCURRENCY=1

# Feed scroll depth
HUGINN_DEPTH=10

# Maps UI language
HUGINN_LANG=en

# Delay before starting a scrape (ms)
HUGINN_REQUEST_PACE_MS=500

# Cancel scrapemate after inactivity
HUGINN_EXIT_IDLE=2m

# REST listen address
HUGINN_HTTP_ADDR=:8080

# Default CLI output
HUGINN_OUTPUT=leads.json
HUGINN_FORMAT=json

# Optional comma-separated proxies
# HUGINN_PROXIES=http://user:pass@host:port

# Headful browser for debugging
HUGINN_DEBUG=false

# Data directory hint for deployments
HUGINN_DATA_DIR=./data
